{
	"extends": "@blake.regalia/tsconfig/tsconfig.node.json",

	"compilerOptions": {
		"outDir": "dist/void",
		"declarationDir": "dist/void",
		"rootDir": ".",
		"incremental": false,
		"moduleResolution": "bundler",

		"paths": {
			"*": ["./*"]
		},
		"types": ["node", "web"],
	},

	"include": [
		"src/**/*.ts",
		"rollup.config.mjs",
		"test/**/*.ts",
	],
}
