{
	"extends": "@blake.regalia/tsconfig/tsconfig.node-cjs.json",

	"compilerOptions": {
		"outDir": "dist/cjs",
		"declarationDir": "dist/cjs",
		"rootDir": "src",
		"incremental": false,
		"moduleResolution": "bundler",
		"module": "commonjs",
		"types": ["node", "web"]
	},

	"include": [
		"src/**/*.ts"
	],
}
