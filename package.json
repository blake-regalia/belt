{
  "name": "@blake.regalia/belt",
  "version": "0.57.9",
  "repository": "github:blake-regalia/belt",
  "license": "ISC",
  "author": {
    "name": "Blake Regalia",
    "email": "blake.regalia@gmail.com"
  },
  "type": "module",
  "main": "dist/cjs/main.cjs",
  "module": "dist/mjs/main.js",
  "types": "dist/mjs/main.d.ts",
  "exports": {
    "import": {
      "types": "./dist/mjs/main.d.ts",
      "default": "./dist/mjs/main.js"
    },
    "require": {
      "types": "./dist/cjs/main.d.cts",
      "default": "./dist/cjs/main.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:mjs": "tsc -p tsconfig.mjs.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && bash scripts/cjs-fix.sh",
    "build": "rm -rf dist && pnpm run build:mjs && pnpm run build:cjs",
    "bundle": "rollup --config rollup.config.mjs",
    "test": "pnpm run build && bun test ./test/*.ts"
  },
  "devDependencies": {
    "@blake.regalia/eslint-config-elite": "^0.6.1",
    "@blake.regalia/tsconfig": "^0.4.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.2.0",
    "@types/web": "^0.0.354",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.32.0",
    "rollup": "^4.62.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.14.0"
}
